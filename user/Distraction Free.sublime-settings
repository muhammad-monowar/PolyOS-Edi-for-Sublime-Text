{
  // Layout & Focus
  "draw_centered": true,
  "word_wrap": true,
  "wrap_width": 50,
  "typewriter_mode_scrolling": true,

  // Typography & Caret
  "font_face": "JetBrains Mono",
  "font_size": 15,
  "line_padding_top": 8,
  "line_padding_bottom": 8,
  "block_caret": true,
  "caret_style": "solid",

  // Custom Color Scheme Hook
  "color_scheme": "Packages/User/MustafasProseMode.sublime-color-scheme",

  // Minimal UI Clean-out
  "line_numbers": false,
  "gutter": false,
  "fold_buttons": false,
  "draw_indent_guides": false,
  "highlight_line": false,
  "show_minimap": false,

  // Distraction-Free Behavior (Completions Off)
  "auto_complete": false,
  "tab_completion": false,
  "auto_match_enabled": false,

  // Spell Check (Can be toggled with F6 / Command Palette)
  "spell_check": true,
  "save_on_focus_lost": true
}