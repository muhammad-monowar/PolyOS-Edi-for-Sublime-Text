{
  "name": "ProseMode",
  "globals": {
    "background": "#181818",
    "foreground": "#D4D4D4",
    "caret": "#D4D4D4",
    "line_highlight": "#202020",

    // PolyOS Editor Dark compatibility hooks (kind + accent colors)
    "accent": "#72EFA6",
    "redish": "#F08080",
    "orangish": "#D9A066",
    "yellowish": "#D8C97A",
    "greenish": "#72EFA6",
    "cyanish": "#7FE3C8",
    "bluish": "#8FB8E8",
    "purplish": "#B09DE0",
    "pinkish": "#E88FA0",

    // Low-opacity warm amber tone for subtle spell check underline
    "misspelling": "rgba(206, 145, 120, 0.4)"
  },
  "rules": [
    {
      "name": "Muted Text Base",
      "scope": "text",
      "foreground": "#B5B5B5"
    },
    {
      "name": "Subtle Misspelling Hue Shift",
      "scope": "invalid.illegal, markup.italic.spell_check",
      "foreground": "#DCDCAA",
      "font_style": "no-italics"
    }
  ]
}