%YAML 1.2
---
# -----------------------------------------------------------------------------
# PolyMark-Language-Pack-Shell -- Fenced Shell/Bash highlighting for PolyMark
# -----------------------------------------------------------------------------
# This hidden syntax is not meant to be selected manually. PolyMark's
# `fenced-language-extensions` context includes it by scope, so any fenced code
# block tagged `bash`, `sh`, `shell`, `zsh` or `console` is embedded as
# `source.shell` (Sublime Text's built-in shell highlighting).
#
# Scopes emitted here are styled by polymark.sublime-color-scheme (the E20
# shared code-block palette). No PolyMark rules seep into the block and the
# block's rules do not seep back out.
#
# License: MIT (see `LICENSE`).
# Setup  : See `Instructions.md` in the PolyMark package.

name: PolyMark Fenced Shell
scope: source.embedded.polymark.bash
hidden: true

contexts:
  main:
    # A correctly typed opening fence: three backticks, a shell language token
    # and nothing else on the line. The closing fence (three backticks alone)
    # ends the embed no matter how nested the shell content is.
    - match: '^([ \t]*)(```)[ \t]*(bash|sh|shell|zsh|console)[ \t]*$'
      captures:
        2: punctuation.definition.raw.code-fence.begin.polymark
        3: constant.other.language-name.polymark
      embed: scope:source.shell
      embed_scope: markup.raw.block.polymark
      escape: '^([ \t]*)(```)[ \t]*$'
      escape_captures:
        2: punctuation.definition.raw.code-fence.end.polymark
