{
  /* 
    ---
    Author: Muhammad Mustafa Monowar
    Updated: 2026-08-06
    Target: Sublime Text
    Version: v3.1.0
    ---
    PolyMark System Preferences
  */

  "font_size": 14,
  "font_face": "JetBrains Mono",
  "font_options": [
    "dlig",
    "calt",
    "directwrite",
    "subpixel_antialias"
  ],

  "theme": "PolyOS Editor Dark.sublime-theme",
  "color_scheme": "Packages/PolyMark/polymark.sublime-color-scheme",
  "default_syntax": "Packages/PolyMark/polymark.sublime-syntax",

  "ignored_packages": [
    "Vintage"
  ],

  "save_on_focus_lost": true,
  "highlight_line": false,

  // Caret Config (Block caret active globally)
  "block_caret": true,
  "caret_style": "smooth",

  "word_wrap": true,
  "indent_subsequent_lines": true,
  "line_padding_top": 0,
  "line_padding_bottom": 0,
  // Windows-only; ignored on macOS
  // "hardware_acceleration": "opengl",

  "trim_trailing_white_space_on_save": false,
  "index_files": false,

  // Code Mode Auto-Complete
  "auto_complete": true,
  "tab_completion": false,
  "auto_complete_commit_on_tab": false,
  "auto_complete_selector": "meta.tag, source, text.html, text.plain"
}