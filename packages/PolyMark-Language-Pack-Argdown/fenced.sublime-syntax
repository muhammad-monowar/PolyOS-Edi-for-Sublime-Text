%YAML 1.2
---
# -----------------------------------------------------------------------------
# PolyMark-Language-Pack-Argdown -- Fenced Argdown highlighting for PolyMark
# -----------------------------------------------------------------------------
# This hidden syntax is not meant to be selected manually. PolyMark's
# `fenced-language-extensions` context includes it by scope, so any fenced code
# block tagged `argdown`, `argdown-map` or `ad` is embedded as `source.argdown`
# (the bundled `argdown.sublime-syntax` in this package).
#
# Scopes emitted here are styled by polymark.sublime-color-scheme (E20 shared
# code-block palette). No PolyMark rules seep into the block and the block's
# rules do not seep back out.
#
# License: MIT (see `LICENSE`).
# Setup  : See `Instructions.md` in the PolyMark package.

name: PolyMark Fenced Argdown
scope: source.embedded.polymark.argdown
hidden: true

contexts:
  main:
    # A correctly typed opening fence: three backticks, an argdown language
    # token and nothing else on the line. The closing fence (three backticks
    # alone) ends the embed no matter how nested the argdown content is.
    - match: '^([ \t]*)(```)[ \t]*(argdown|argdown-map|ad)[ \t]*$'
      captures:
        2: punctuation.definition.raw.code-fence.begin.polymark
        3: constant.other.language-name.polymark
      embed: scope:source.argdown
      embed_scope: markup.raw.block.polymark
      escape: '^([ \t]*)(```)[ \t]*$'
      escape_captures:
        2: punctuation.definition.raw.code-fence.end.polymark
