{
  // Windows-only preferences (loaded only on Windows).
  // Loaded after Packages/PolyOSPlatform/Preferences.sublime-settings and
  // before Packages/User/Preferences.sublime-settings. Keys defined here must
  // NOT be redefined in the shared Packages/User/Preferences.sublime-settings,
  // otherwise the User value would win.
  //
  // font_options extends the shared ["dlig", "calt"] with Windows-specific
  // font rendering flags. hardware_acceleration enables the OpenGL renderer.
  "font_options": ["dlig", "calt", "directwrite", "subpixel_antialias"],
  "hardware_acceleration": "opengl"
}
