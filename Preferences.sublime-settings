{
  /* 
    ---
    Author: Muhammad Mustafa Monowar
    Updated: 2026-10-05
    Target: Sublime Text
    Version: v1.0.0
    ---
    PolyOS Editor — shared preferences.

    Sublime merges same-named settings across all packages and consults
    Packages/User last. Every value below is therefore a DEFAULT: if the user
    has already set the same key in their own Preferences.sublime-settings,
    their value wins and this file is ignored for that key. Nothing here can
    override a user setting.

    Keys that visibly change someone's editor are deliberately NOT set here.
    theme, color_scheme, default_syntax and font_size are applied by
    activate_profile.py, which asks first and skips any key the user has
    already changed away from Sublime's stock value.
  */

  "font_face": "JetBrains Mono",
  // Cross-platform font options. Windows adds `directwrite` and
  // `subpixel_antialias` via Preferences (Windows).sublime-settings.
  "font_options": [
    "dlig",
    "calt"
  ],

  "ignored_packages": [
    "Vintage"
  ],

  "save_on_focus_lost": true,
  "highlight_line": false,

  // Caret Config (Block caret active globally)
  "block_caret": true,
  "caret_style": "smooth",

  "word_wrap": true,
  "indent_subsequent_lines": true,
  "line_padding_top": 0,
  "line_padding_bottom": 0,

  "trim_trailing_white_space_on_save": false,
  "index_files": false,

  // Code Mode Auto-Complete
  "auto_complete": true,
  "tab_completion": false,
  "auto_complete_commit_on_tab": false,
  "auto_complete_selector": "meta.tag, source, text.html, text.plain",
}