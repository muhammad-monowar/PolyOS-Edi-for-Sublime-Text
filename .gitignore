# Sublime Text auto-generated / local-only files
Session.sublime_session
Session.sublime_session.*
Workspace.sublime_workspace
*.sublime-workspace
*.sublime-project
Package Control.last-run
Package Control.cache
Package Control.user-ca-bundle
*.cache

# Generated by Package Control on install
package-metadata.json

# OS noise
.DS_Store
Thumbs.db

# Windows NTFS alternate-data streams, picked up when files are copied out of
# Windows. Package Control zips the whole tree, so these would ship.
*:Zone.Identifier

# Python bytecode from running the plugin locally
__pycache__/
*.py[cod]